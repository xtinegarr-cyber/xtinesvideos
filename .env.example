# Copy this to .env for running on your own computer. On the server, enter
# these in Coolify's "Environment Variables" tab instead. Never commit .env.

# --- Required ---------------------------------------------------------------

# The PostgreSQL connection string. Coolify shows it on your database's page.
DATABASE_URL=postgresql://postgres:password@localhost:5432/xtines

# Your admin account. It's created the first time the site starts.
ADMIN_USERNAME=xtinegar
# At least 12 characters. This is always the admin's login password: change
# it here and restart the site to change it (it also logs the admin out).
ADMIN_PASSWORD=

# A long random string (e.g. from a password generator). Used to make
# anonymous visitor IDs for view counting.
APP_SECRET=

# Your site's address, used for links back from Stripe checkout.
SITE_URL=https://yourdomain.com

# --- Header links -------------------------------------------------------------

DISCORD_URL=https://discord.com
TELEGRAM_URL=https://telegram.org

# --- Cloudflare R2 (videos, photos, profile pictures) -------------------------

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Stripe (VIP at $4.99/month) ------------------------------------------------

STRIPE_SECRET_KEY=
STRIPE_VIP_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Optional ------------------------------------------------------------------

# Largest single upload, in GB (default 10).
# MAX_UPLOAD_GB=10
# How many uploads ffmpeg processes at once (default 1).
# PROCESSING_CONCURRENCY=1
# Where uploads wait while they're processed (default: the system temp folder).
# UPLOAD_TMP_DIR=/data/uploads
# Price shown on the site. The real charge comes from the Stripe price.
# NEXT_PUBLIC_VIP_PRICE_LABEL=$4.99
