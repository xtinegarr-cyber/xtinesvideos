# Copy this to .env for running on your own computer. On the server, enter
# these in Coolify's "Environment Variables" tab instead. Never commit .env.

# --- Required ---------------------------------------------------------------

# The PostgreSQL connection string. Coolify shows it on your database's page.
DATABASE_URL=postgresql://postgres:password@localhost:5432/xtines

# Your admin account. It's created the first time the site starts.
ADMIN_USERNAME=xtinegar
# At least 12 characters. This is always the admin's login password: change
# it here and restart the site to change it (it also logs the admin out).
ADMIN_PASSWORD=

# A long random string (e.g. from a password generator). Used to make
# anonymous visitor IDs for view counting.
APP_SECRET=

# Your site's address, used for links back from Stripe checkout.
SITE_URL=https://yourdomain.com

# --- Header links -------------------------------------------------------------

DISCORD_URL=https://discord.com
TELEGRAM_URL=https://telegram.org

# --- Cloudflare R2 (videos, photos, profile pictures) -------------------------

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Stripe (VIP at $4.99/month) ------------------------------------------------

STRIPE_SECRET_KEY=
STRIPE_VIP_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Free VIP for Reddit posts (optional) -------------------------------------

# A Reddit app lets the site check posts automatically. Without one it tries
# Reddit's public data, and posts Reddit won't show go to the admin panel
# for you to approve by hand. Create one at https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# How long the free VIP lasts, in minutes (default 30).
# NEXT_PUBLIC_FREE_VIP_MINUTES=30

# --- Search engines ------------------------------------------------------------

# New, renamed and deleted pages are sent to Bing right away with IndexNow
# (shared with Yandex, Naver, Seznam and Yep). Nothing to set up; the site
# makes its own key at /indexnow-key.txt. Needs SITE_URL. To turn it off:
# INDEXNOW=off

# --- Optional ------------------------------------------------------------------

# Largest single upload, in GB (default 10).
# MAX_UPLOAD_GB=10
# How many uploads ffmpeg processes at once (default: 1 per 3 CPU cores).
# PROCESSING_CONCURRENCY=2
# H.264 videos up to 1080p and this many Mbps are kept as they are instead
# of being converted, which is much faster (default 20).
# COPY_MAX_MBPS=20
# Where uploads wait while they're processed (default: the system temp
# folder). Point it at a persistent volume (e.g. /data/uploads in Coolify's
# Persistent Storage) so a redeploy doesn't lose files waiting their turn.
# UPLOAD_TMP_DIR=/data/uploads
# Price shown on the site. The real charge comes from the Stripe price.
# NEXT_PUBLIC_VIP_PRICE_LABEL=$4.99
